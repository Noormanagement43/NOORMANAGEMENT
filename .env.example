# ==============================================================================
# NOOR Management (نور) - Environment Variables & Secrets Reference
# ==============================================================================
# IMPORTANT:
# Never commit actual secret keys to git.
# In Supabase, set these secrets via dashboard:
# Project Settings -> Edge Functions -> Secrets
# or via Supabase CLI:
#   supabase secrets set GEMINI_API_KEY=your_key
#   supabase secrets set BREVO_API_KEY=your_key
# ==============================================================================

# Google Gemini API Key (powers AI question paper generation, insights, and media prompts)
GEMINI_API_KEY=your_gemini_api_key_here

# Brevo (Sendinblue) Transactional SMTP API Key for email automation
BREVO_API_KEY=your_brevo_api_key_here

# Default email sender configuration
EMAIL_FROM=annoorhub786@gmail.com
EMAIL_FROM_NAME=NOOR Management (نور)

# Primary academic brain; explicit routing, no silent provider fallback.
NOOR_AI_PROVIDER=gemini
# Server default: gemini-3.5-flash-lite. Override only with an account-accessible model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional OpenAI manager. Choose the model explicitly in your API account.
OPENAI_API_KEY=replace_in_supabase_secrets_only
OPENAI_MANAGER_MODEL=your_account_accessible_model_id
# Optional open-weight alternate provider (set NOOR_AI_PROVIDER=groq to use).
GROQ_API_KEY=replace_in_supabase_secrets_only
GROQ_MODEL=openai/gpt-oss-120b

# Existing Supabase Custom Secrets also supported server-side:
# gemini -> GEMINI_API_KEY, groq -> GROQ_API_KEY,
# chatgpt -> OPENAI_API_KEY, brevo -> BREVO_API_KEY (metadata diagnostics).
# If both names exist, their values must match or AI calls fail closed.
