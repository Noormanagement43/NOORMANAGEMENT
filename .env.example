# ==============================================================================
# NOOR Management (نور) - Environment Variables & Secrets Reference
# ==============================================================================
# IMPORTANT:
# Never commit actual secret keys to git.
# In Supabase, set these secrets via dashboard:
# Project Settings -> Edge Functions -> Secrets
# or via Supabase CLI:
#   supabase secrets set GEMINI_API_KEY=your_key
#   supabase secrets set BREVO_API_KEY=your_key
# ==============================================================================

# Google Gemini API Key (powers AI question paper generation, insights, and media prompts)
GEMINI_API_KEY=your_gemini_api_key_here

# Brevo (Sendinblue) Transactional SMTP API Key for email automation
BREVO_API_KEY=your_brevo_api_key_here

# Default email sender configuration
EMAIL_FROM=annoorhub786@gmail.com
EMAIL_FROM_NAME=NOOR Management (نور)
